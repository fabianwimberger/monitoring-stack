{
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (job) (count_over_time({job=\"$source\", container=~\"$container\"} |~ \"$search\" [$__interval]))",
          "refId": "A"
        }
      ],
      "title": "Log Volume",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 2,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"$source\", container=~\"$container\"} |~ \"$search\"",
          "refId": "A"
        }
      ],
      "title": "Logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "current": {
          "text": "Loki",
          "value": "loki"
        },
        "includeAll": false,
        "label": "Datasource",
        "name": "ds_loki",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "${ds_loki}"
        },
        "includeAll": false,
        "label": "Source",
        "multi": false,
        "name": "source",
        "query": "label_values(job)",
        "refresh": 1,
        "sort": 1,
        "type": "query",
        "current": {}
      },
      {
        "allValue": ".*",
        "datasource": {
          "type": "loki",
          "uid": "${ds_loki}"
        },
        "includeAll": true,
        "label": "Container",
        "multi": false,
        "name": "container",
        "query": "label_values({job=\"$source\"}, container)",
        "refresh": 1,
        "sort": 1,
        "type": "query",
        "current": {}
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "label": "Filter (regex)",
        "name": "search",
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "title": "Loki Log Explorer",
  "uid": "loki-log-explorer",
  "version": 1
}
