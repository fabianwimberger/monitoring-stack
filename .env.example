# Timezone (IANA format)
TZ=UTC

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_MEM_LIMIT=768m

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_MEM_LIMIT=2g

# Loki
LOKI_MEM_LIMIT=768m

# Alloy
ALLOY_MEM_LIMIT=1g

# cAdvisor
CADVISOR_MEM_LIMIT=256m

# Uptime Kuma
UPTIME_KUMA_PORT=3001
UPTIME_KUMA_MEM_LIMIT=512m

# Host Docker group ID for Alloy container access
# (run: getent group docker | cut -d: -f3)
# DOCKER_GID=999

# Reverse proxy (optional — used with docker-compose.proxy.yml)
# PROXY_NETWORK=proxy
# GRAFANA_DOMAIN=grafana.example.com
# UPTIME_KUMA_DOMAIN=uptime.example.com
# TRAEFIK_CERTRESOLVER=letsencrypt
