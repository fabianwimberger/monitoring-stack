discovery.docker "docker" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "10s"
}

discovery.relabel "docker" {
	targets = discovery.docker.docker.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		target_label = "job"
		replacement  = "docker"
	}

	// Drop logs from monitoring stack containers to avoid feedback loops
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(loki|grafana|alloy|prometheus|cadvisor|uptime-kuma).*"
		action        = "drop"
	}
}

loki.source.docker "docker" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.docker.docker.targets
	forward_to       = [loki.write.default.receiver]
	relabel_rules    = discovery.relabel.docker.rules
	refresh_interval = "10s"
}

loki.source.journal "systemd" {
	max_age       = "12h0m0s"
	path          = "/var/log/journal"
	relabel_rules = null
	forward_to    = [loki.write.default.receiver]
	labels        = {
		job = "systemd",
	}
}

// OpenWrt logd forwards RFC3164 over UDP.
loki.relabel "syslog" {
	forward_to = []

	rule {
		source_labels = ["__syslog_message_hostname"]
		target_label  = "host"
	}

	rule {
		source_labels = ["__syslog_message_app_name"]
		target_label  = "app"
	}
}

loki.source.syslog "openwrt" {
	listener {
		address       = "0.0.0.0:514"
		protocol      = "udp"
		syslog_format = "rfc3164"
		labels        = {
			job = "openwrt",
		}
	}
	relabel_rules = loki.relabel.syslog.rules
	forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
	external_labels = {
		host = sys.env("HOSTNAME"),
	}
}
